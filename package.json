{
  "name": "fukidashi-bot",
  "version": "1.0.0",
  "private": true,
  "description": "DiscordスラッシュコマンドBot",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first node dist/index.js",
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "seed-questions": "tsx src/seedQuestions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "mongodb": "^6.11.0",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "discord-api-types": "^0.38.49"
  }
}
